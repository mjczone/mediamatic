<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Product>MediaMatic ASP.NET Core</Product>
    <PackageId>MJCZone.MediaMatic.AspNetCore</PackageId>
    <Summary>ASP.NET Core integration for MediaMatic - Web API endpoints for media management.</Summary>
    <Description>ASP.NET Core integration for MediaMatic with browser-aware optimization and minimal API endpoints</Description>
    <PackageTags>aspnetcore;media;files;storage;webp;avif;api;middleware</PackageTags>
    <RepositoryUrl>https://github.com/mjczone/mediamatic</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://mediamatic.mjczone.com/</PackageProjectUrl>
    <DisableImplicitAspNetCoreAnalyzers>true</DisableImplicitAspNetCoreAnalyzers>
    <NoWarn>AD0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="[2.1.35,3.0.0)" />
    <PackageReference Include="MJCZone.DapperMatic" Version="[0.1.3,1.0.0)" />
    <PackageReference Include="DeviceDetector.NET" Version="6.4.7" />
    <PackageReference Include="JsonFlatFileDataStore" Version="2.4.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MJCZone.MediaMatic\MJCZone.MediaMatic.csproj" />
  </ItemGroup>
</Project>
